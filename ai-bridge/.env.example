# AI bridge secrets — live ONLY on the server (/opt/ai-bridge/env, chmod 600),
# never in git, never on clients.
#
# Copy to /opt/ai-bridge/env (or pass to deploy.sh) and fill in real values.

# z.ai API key (ZhipuAI GLM). Required.
ZAI_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ChatGPT session token for the /quota/openai route. Optional — omit the whole
# line if you don't use the ChatGPT quota chip.
OPENAI_TOKEN=eyJhbGciOi...
